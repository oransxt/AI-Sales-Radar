function news_(ctx,start){var p=PropertiesService.getScriptProperties(),feeds=rows_('Feeds').filter(function(f){return RevenueCore.yes(f.active);}),out=[],seen={};if(RevenueCore.yes(ctx.config.watchlist_news_enabled)){var cursor=Number(p.getProperty('BRAND_CURSOR')||0),n=Math.min(12,Number(ctx.config.watchlist_queries_per_run||8));for(var j=0;j<Math.min(n,ctx.accounts.length);j++){var a=ctx.accounts[(cursor+j)%ctx.accounts.length],q='"'+a.brand.replace(/"/g,'')+'" (เปิดตัว OR ขยายสาขา OR campaign OR launch OR expansion) when:14d';feeds.push({url:'https://news.google.com/rss/search?q='+encodeURIComponent(q)+'&hl=th&gl=TH&ceid=TH:th',brand_hint:a.brand,industry_hint:a.industry});}p.setProperty('BRAND_CURSOR',String((cursor+n)%Math.max(1,ctx.accounts.length)));}
if(feeds.length>20){var feedCursor=Number(p.getProperty('FEED_CURSOR')||0),rotated=[];for(var fi=0;fi<20;fi++)rotated.push(feeds[(feedCursor+fi)%feeds.length]);p.setProperty('FEED_CURSOR',String((feedCursor+20)%feeds.length));feeds=rotated;}feeds.forEach(function(feed){if(Date.now()-start>130000)return;if(!/^https:\/\//.test(feed.url))return;try{var r=UrlFetchApp.fetch(feed.url,{muteHttpExceptions:true,followRedirects:true});if(r.getResponseCode()!==200)throw Error('RSS HTTP '+r.getResponseCode());var channel=XmlService.parse(r.getContentText()).getRootElement().getChild('channel');if(!channel)throw Error('รองรับ RSS2 เท่านั้น');channel.getChildren('item').slice(0,60).forEach(function(item){var title=item.getChildText('title')||'',url=item.getChildText('link')||'',dt=new Date(item.getChildText('pubDate')||''),sig=RevenueCore.signal(title);if(!sig||!isFinite(+dt)||+dt>Date.now()+86400000||Date.now()-dt>Number(ctx.config.news_max_age_days||14)*86400000||!/^https:\/\//.test(url))return;var matches=ctx.accounts.filter(function(a){return RevenueCore.detectAccount(title,[a]);}),a=matches.length===1?matches[0]:null;if(matches.length>1)return;if(!a&&!feed.brand_hint)return;/* Unmapped brand feeds use an explicit verified brand hint, never guessed from a headline. */if(!a&&feed.brand_hint&&!RevenueCore.detectAccount(title,[{brand:feed.brand_hint}]))return;var brand=a?a.brand:feed.brand_hint,publisher=item.getChild('source'),name=publisher?publisher.getText():channel.getChildText('title')||'',day=Utilities.formatDate(dt,'Asia/Bangkok','yyyy-MM-dd'),clean=title.replace(/\s+-\s+[^-]+$/,'').trim(),id='news-'+digest_(RevenueCore.norm(brand)+'|'+RevenueCore.norm(clean));if(seen[id])return;seen[id]=true;out.push({id:id,account_id:a?a.id:'',brand:brand,industry:a?a.industry:feed.industry_hint,title:title,source_url:url,publisher:name,published_at:day});});}catch(e){audit_('RSS_ERROR','',String(feed.url).slice(0,150)+': '+e.message);}});return out;}
