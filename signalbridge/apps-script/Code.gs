function indexDocuments_(c,start){if(!c.credential_root_folder_id)return;var p=PropertiesService.getScriptProperties(),root=String(c.credential_root_folder_id),state;try{state=JSON.parse(p.getProperty('DOC_SCAN')||'null');}catch(e){}if(!state||state.root!==root)state={root:root,run:timestamp_(),queue:[{id:root,path:'',token:''}]};if(state.queue.length){var q=state.queue[0],res=Drive.Files.list({q:"'"+q.id.replace(/'/g,'')+"' in parents and trashed = false",pageSize:100,pageToken:q.token||undefined,fields:'nextPageToken,files(id,name,mimeType,modifiedTime,webViewLink)',supportsAllDrives:true,includeItemsFromAllDrives:true});(res.files||[]).forEach(function(f){if(f.mimeType==='application/vnd.google-apps.folder'){if(state.queue.length<150)state.queue.push({id:f.id,path:q.path+'/'+f.name,token:''});else throw Error('โฟลเดอร์เกิน 150');return;}var old=rows_('Documents').find(function(x){return x.id===f.id;})||{},unchanged=old.modified_at===f.modifiedTime&&old.status==='READY'&&old.folder_path===q.path&&old.kind===kind_(q.path);upsert_('Documents',Object.assign({},old,{id:f.id,file_name:f.name,kind:kind_(q.path),folder_path:q.path,drive_url:f.webViewLink||'https://drive.google.com/file/d/'+f.id+'/view',modified_at:f.modifiedTime,seen_run:state.run,status:unchanged?'READY':'PENDING'}));});if(res.nextPageToken)q.token=res.nextPageToken;else state.queue.shift();}
var pending=rows_('Documents').filter(function(d){return d.status==='PENDING';}).slice(0,Math.min(8,Number(c.credentials_per_run||4)));pending.forEach(function(d){if(Date.now()-start>100000)return;try{var text=readDocumentText_(d.id),summary=RevenueCore.describeDoc(text,d.kind,d.folder_path);if(!summary)throw Error('อ่านข้อความได้ไม่เพียงพอ');Object.assign(d,summary,{status:'READY',readers:permissions_(d.id),error:''});}catch(e){d.status='ERROR';d.error=String(e.message).slice(0,500);}upsert_('Documents',d);});if(!state.queue.length){rows_('Documents').filter(function(d){return d.seen_run!==state.run;}).forEach(function(d){d.status='REMOVED';upsert_('Documents',d);});p.deleteProperty('DOC_SCAN');}else p.setProperty('DOC_SCAN',JSON.stringify(state));}
function readDocumentText_(id){var file=DriveApp.getFileById(id),mime=file.getMimeType(),temp='',text='';try{if(mime==='application/vnd.google-apps.document')return DocumentApp.openById(id).getBody().getText().slice(0,40000);if(mime==='application/vnd.google-apps.presentation')return slidesText_(id);if(mime==='text/plain')return file.getBlob().getDataAsString().slice(0,40000);if(file.getSize()>10*1024*1024)throw Error('ไฟล์เกิน 10MB: แปลงเป็น Google Docs / Slides หรือสรุปเป็นไฟล์ข้อความ');var asSlides=/presentation|powerpoint/.test(mime),asDocs=mime==='application/pdf'||/wordprocessingml|msword/.test(mime);if(!asSlides&&!asDocs)throw Error('รูปแบบไม่รองรับ: ใช้ PDF, Docs, Slides, PPTX, DOCX หรือ TXT');var result=Drive.Files.create({name:'RA-temp-'+id,mimeType:asSlides?'application/vnd.google-apps.presentation':'application/vnd.google-apps.document'},file.getBlob(),{fields:'id',ocrLanguage:'th'});temp=result.id;text=asSlides?slidesText_(temp):DocumentApp.openById(temp).getBody().getText();return text.slice(0,40000);}finally{if(temp)DriveApp.getFileById(temp).setTrashed(true);}}
function slidesText_(id){var out=[];SlidesApp.openById(id).getSlides().forEach(function(s){s.getPageElements().forEach(function(e){if(e.getPageElementType()===SlidesApp.PageElementType.SHAPE)out.push(e.asShape().getText().asString());else if(e.getPageElementType()===SlidesApp.PageElementType.TABLE){var t=e.asTable();for(var r=0;r<t.getNumRows();r++)for(var c=0;c<t.getNumColumns();c++)out.push(t.getCell(r,c).getText().asString());}});});return out.join('\n').slice(0,40000);}
function recipients_(s){var out=String(s||'').split(/[;,]/).map(function(x){return x.trim();}).filter(Boolean);if(out.length>10||out.some(function(x){return !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(x);}))throw Error('digest_to ต้องเป็นอีเมลไม่เกิน 10 คน');return Array.from(new Set(out));}
function digestBody_(batch,ctx){var esc=RevenueCore.esc,html='<h2>SignalBridge — 20 Signals</h2><p>บริบทและ Knowledge เป็นมุมมองประกอบการหารือ อีเมลลูกค้ายังไม่ได้ส่ง</p>';['NEW_OPPORTUNITY','UPSALES','NEEDS_CLASSIFICATION'].forEach(function(cat){var list=batch.filter(function(d){return d.category===cat;});if(!list.length)return;html+='<h3>'+({NEW_OPPORTUNITY:'New Opportunity',UPSALES:'Upsales',NEEDS_CLASSIFICATION:'รอระบุประเภทลูกค้า'})[cat]+'</h3>';list.forEach(function(d){html+='<div style="border-bottom:1px solid #ddd;padding:12px 0"><b>'+esc(d.brand)+'</b> · '+esc(d.signal_type)+'<p><a href="'+esc(d.source_url)+'">'+esc(d.title)+'</a><br><small>'+esc(d.publisher)+' · '+esc(d.published_at)+'</small></p><p>บริบท Knowledge: '+esc(d.objective)+'</p>'+(d.credentials.length?'<ul>'+RevenueCore.selectedDocs(d,ctx).filter(function(c){return c.status==='READY';}).map(function(c){return '<li><a href="'+esc(c.drive_url)+'">'+esc(c.title_th)+'</a></li>';}).join('')+'</ul>':'<p>ยังไม่มี Knowledge ที่เกี่ยวข้องและอ่านได้</p>')+'<small>Signal ID: '+esc(d.id)+'</small></div>';});});return html+'<p><a href="https://docs.google.com/spreadsheets/d/'+esc(PropertiesService.getScriptProperties().getProperty('SHEET_ID'))+'/edit">เปิดหน้าตรวจใน Google Sheet → SignalBridge</a></p>';}
function sendDigest_(ctx){if(!RevenueCore.yes(ctx.config.digest_enabled)||!RevenueCore.windowOpen(new Date()))return 'PAUSED';var history=rows_('Deliveries');if(history.some(function(r){return r.status==='SENDING'||r.status==='UNCERTAIN';}))return 'HELD_UNCERTAIN';var sent={};history.filter(function(r){return r.status==='SENT';}).forEach(function(r){String(r.signal_ids).split('|').forEach(function(id){sent[id]=true;});});var batch=RevenueCore.fullBatch(deals_().map(function(d){d.category=RevenueCore.classify(ctx.accounts.find(function(a){return a.id===d.account_id;}));return d;}),sent,new Date(),ctx.config.news_max_age_days);if(batch.length<20)return 'WAITING_FOR_20';var recipients=internalRecipients_(ctx.config.digest_to);if(!recipients.length)return 'NO_RECIPIENT';if(MailApp.getRemainingDailyQuota()<recipients.length)return 'QUOTA_WAIT';/* Recheck immediately before side effect, including after slow scans. */if(!RevenueCore.windowOpen(new Date()))return 'PAUSED';var id='batch-'+digest_(batch.map(function(d){return d.id;}).join('|')),record=history.find(function(r){return r.id===id;})||{id:id,signal_ids:batch.map(function(d){return d.id;}).join('|'),subject:'SignalBridge | 20 Signals | '+today_()+' [RA-BATCH:'+id+']',draft_id:'',message_id:''};var html=digestBody_(batch,ctx);if(!record.draft_id){var found=GmailApp.getDrafts().filter(function(d){return d.getMessage().getSubject()===record.subject;});if(found.length>1)throw Error('Digest draft ซ้ำ');var draft=found[0]||GmailApp.createDraft(recipients.join(','),record.subject,'20 business signals — เปิดอีเมลแบบ HTML เพื่อดูรายการ',{htmlBody:html});record.draft_id=draft.getId();record.status='READY';record.updated_at=timestamp_();upsert_('Deliveries',record);}if(!RevenueCore.windowOpen(new Date()))return 'PAUSED';record.status='SENDING';record.updated_at=timestamp_();upsert_('Deliveries',record);SpreadsheetApp.flush();try{var msg=GmailApp.getDraft(record.draft_id).send();record.message_id=msg.getId();record.status='SENT';record.updated_at=timestamp_();upsert_('Deliveries',record);audit_('DIGEST_SENT',id,'20 signals');return 'SENT_20';}catch(e){/* No automatic resend after an ambiguous network failure. */record.status='UNCERTAIN';record.error=String(e.message).slice(0,500);upsert_('Deliveries',record);audit_('DELIVERY_UNCERTAIN',id,record.error);return 'UNCERTAIN';}}
function reconcileDeliveries_(){rows_('Deliveries').filter(function(r){return ['SENDING','UNCERTAIN'].indexOf(r.status)>=0;}).forEach(function(r){var threads=GmailApp.search('in:sent subject:"RA-BATCH:'+r.id+'"',0,10),matches=[];threads.forEach(function(t){t.getMessages().forEach(function(m){if(m.getSubject()===r.subject&&m.getFrom().indexOf(Session.getEffectiveUser().getEmail())>=0)matches.push(m);});});if(matches.length){r.status='SENT';r.message_id=matches[0].getId();r.error='';}else{try{GmailApp.getDraft(r.draft_id);r.status='READY';r.error='Draft still exists; retry next work-window tick';}catch(e){r.status='UNCERTAIN';r.error='ไม่พบ Draft หรือ Sent ที่ยืนยันได้ ตรวจใน Gmail ก่อน';}}r.updated_at=timestamp_();upsert_('Deliveries',r);});}
function reconcileDeliveries(){assertOwner_();return lock_(function(){reconcileDeliveries_();return getReviewBundle();});}

function internalRecipients_(value){var list=recipients_(value),domain=String(PropertiesService.getScriptProperties().getProperty('INSTALLER_EMAIL')||'').toLowerCase().split('@')[1];if(!domain||list.some(function(mail){return mail.toLowerCase().split('@')[1]!==domain;}))throw Error('digest_to ต้องเป็นผู้รับภายในโดเมนเดียวกับบัญชีผู้ติดตั้ง');return list;}
function productionStatus(){assertOwner_();var ctx=context_(),c=ctx.config,blockers=[],warnings=[],owner=PropertiesService.getScriptProperties().getProperty('INSTALLER_EMAIL'),recipients=[];
 if(!ctx.accounts.length||ctx.accounts.every(function(a){return /^DEMO-/i.test(a.id)||/^Demo /i.test(a.brand);}))blockers.push('นำเข้า Brand Master จริงแทนข้อมูล Demo');
 var unknown=ctx.accounts.filter(function(a){return RevenueCore.classify(a)==='NEEDS_CLASSIFICATION';}).length;if(unknown)warnings.push(unknown+' แบรนด์ยังเป็น UNKNOWN และจะสร้าง customer draft ไม่ได้');
 if(!c.credential_root_folder_id)blockers.push('ตั้ง credential_root_folder_id');
 var ready=ctx.credentials.filter(function(d){return d.status==='READY';}).length;if(!ready)blockers.push('ต้องมี Knowledge ที่อ่านได้และตรวจสรุปแล้วอย่างน้อย 1 รายการ');
 if(!String(c.sales_name||'').trim()||/ผู้ดูแลบัญชี|Account Manager/i.test(c.sales_name))blockers.push('ตั้งชื่อผู้ส่งจริง');
 ['signature_th','signature_en'].forEach(function(k){if(!String(c[k]||'').trim()||/ชื่อผู้ส่ง|Sender name|Company name|ชื่อบริษัท/.test(c[k]))blockers.push('ตั้งลายเซ็น '+k+' จริง');});
 try{recipients=internalRecipients_(c.digest_to);if(!recipients.length)blockers.push('ตั้ง digest_to ภายในบริษัท');}catch(e){blockers.push(e.message);}
 if(!RevenueCore.yes(c.news_enabled))blockers.push('เปิด news_enabled เมื่อทดสอบแหล่งข่าวแล้ว');
 if(!RevenueCore.yes(c.watchlist_news_enabled)&&!rows_('Feeds').some(function(f){return RevenueCore.yes(f.active)&&/^https:\/\//.test(f.url);}))blockers.push('ตั้ง RSS ที่ใช้งานได้หรือเปิด watchlist_news_enabled');
 if(!RevenueCore.yes(c.digest_enabled))blockers.push('ตั้ง digest_enabled=TRUE เมื่อพร้อมเปิดใช้งาน');
 if(rows_('Deliveries').some(function(r){return r.status==='SENDING'||r.status==='UNCERTAIN';}))blockers.push('ตรวจและกระทบยอด Deliveries ที่ยังไม่ยืนยัน');
 var quota=MailApp.getRemainingDailyQuota();if(quota<recipients.length)warnings.push('โควตาอีเมลวันนี้ไม่พอ ระบบจะพักคิว');
 warnings.push('Trigger เริ่มส่งได้ตั้งแต่ 08:30 แต่เวลาที่ Google เรียกอาจล่าช้า');
 return {version:'2.3.0',owner:owner,ready:!blockers.length,blockers:blockers,warnings:warnings,brands:ctx.accounts.length,knowledge_ready:ready,recipients:recipients,mail_quota:quota,window:'Asia/Bangkok Mon-Fri 08:30 <= time <18:00',ai_mode:'Company Gemini via browser, operated by salesperson. No LLM API.'};
}
function showProductionStatus(){var r=productionStatus();SpreadsheetApp.getUi().alert('SignalBridge 2.3\n'+(r.ready?'พร้อมเปิด Schedule':'ยังต้องตั้งค่า')+'\n'+r.blockers.concat(r.warnings).join('\n'));return r;}
function activateProduction(){var r=productionStatus();if(!r.ready)throw Error(r.blockers.join('\n'));installSchedule();return r;}
