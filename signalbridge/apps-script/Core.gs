 var result={};['TH','EN'].forEach(function(lang){var e=value[lang];if(!e||typeof e.subject!=='string'||typeof e.body!=='string'||!e.subject.trim()||!e.body.trim()||e.subject.length>200||e.body.length>16000||/[\r\n]/.test(e.subject))throw Error('Subject / Body '+lang+' ไม่ครบหรือยาวเกินกำหนด');if(/https?:\/\/|www\./i.test(e.body))throw Error('นำ URL ออกจาก body ระบบเติมลิงก์ที่เลือกไว้ให้เอง');result[lang]={subject:e.subject.trim(),body:e.body.trim()};});
