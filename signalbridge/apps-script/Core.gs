function validate(d,ctx){var errors=[],warnings=[],a=ctx.accounts.find(function(a){return a.id===d.account_id;});if(classify(a)!==d.category)errors.push('สถานะลูกค้าเปลี่ยน กรุณาจัดประเภทใหม่');if(d.category==='NEEDS_CLASSIFICATION')errors.push('กำหนด customer_type เป็น EXISTING หรือ PROSPECT ใน Brand Master');if(!d.review_confirmed)errors.push('ตรวจเนื้อหาและยืนยันขั้นสุดท้าย');if(!/^https:\/\//.test(d.source_url||''))errors.push('ไม่มีลิงก์ข่าวต้นทาง');if(!d.published_at||!d.title||!isFinite(+new Date(d.published_at)))errors.push('ข้อมูลข่าวไม่ครบ');else if(+new Date(ctx.now)-+new Date(d.published_at)>Number(ctx.config.news_max_age_days||14)*86400000)errors.push('Signal เก่ากว่าช่วงที่กำหนด กรุณาตรวจและนำข่าวล่าสุดเข้าระบบ');if(!/^[^\s@,;<>]+@[^\s@,;<>]+\.[^\s@,;<>]+$/.test(d.email_to||''))errors.push('ตรวจอีเมลผู้รับ');if(['TH','EN'].indexOf(d.language)<0)errors.push('เลือกภาษา TH หรือ EN');var e=d.emails&&d.emails[d.language];if(!e||typeof e.subject!=='string'||typeof e.body!=='string'||!e.subject.trim()||!e.body.trim()||/[\r\n]/.test(e.subject))errors.push('Subject / Body ไม่ถูกต้อง');if(d.outreach_mode!=='KNOWLEDGE')errors.push('สร้างอีเมลใหม่ในโหมด Knowledge sharing');if(!Array.isArray(d.credentials)||d.credentials.length>3)errors.push('เอกสารต้องไม่เกิน 3 รายการ');var ids={};selectedDocs(d,ctx).forEach(function(c){if(ids[c.id])errors.push('เอกสารซ้ำ');ids[c.id]=true;if(!String(c.summary_th||'').trim()||!String(c.summary_en||'').trim())errors.push('สรุป Knowledge TH / EN ไม่ครบ: '+c.id);if(c.status!=='READY'||!driveURL(c.drive_url))errors.push('เอกสารยังอ่านไม่ได้หรือถูกนำออก: '+c.id);var selected=d.credentials.find(function(s){return s.id===c.id;});if(selected.modified_at!==c.modified_at)errors.push('เอกสารเปลี่ยน กรุณาเลือกและตรวจใหม่: '+c.id);['title_th','title_en'].forEach(function(k){if(!c[k]||!c[k].trim()||c[k]===c.file_name||/\.(pdf|pptx?|docx?)$/i.test(c[k]))errors.push('ใช้ชื่อสรุปเนื้อหาแทนชื่อไฟล์: '+c.id);});if(!readersAllow(c,d.email_to)&&!d.link